<?xml version="1.0" encoding="UTF-8"?>
<thing:thing-descriptions bindingId="danfosslink"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:thing="https://openhab.org/schemas/thing-description/v1.0.0"
	xsi:schemaLocation="https://openhab.org/schemas/thing-description/v1.0.0 https://openhab.org/schemas/thing-description-1.0.0.xsd">

	<bridge-type id="controller">
		<label>Danfoss Link Controller</label>
		<description>Danfoss Link CC connected through the cloud relay</description>

		<channels>
			<channel id="pause" typeId="pause"/>
			<channel id="pause-until" typeId="pause-until"/>
			<channel id="vacation" typeId="vacation"/>
			<channel id="vacation-state" typeId="vacation-state"/>
			<channel id="vacation-start" typeId="vacation-start"/>
			<channel id="vacation-end" typeId="vacation-end"/>
		</channels>

		<config-description>
			<parameter name="refreshInterval" type="integer" unit="s" min="10">
				<label>Refresh Interval</label>
				<description>Interval between cloud requests</description>
				<default>60</default>
			</parameter>
		</config-description>
	</bridge-type>

	<thing-type id="living-zone">
		<supported-bridge-type-refs>
			<bridge-type-ref id="controller"/>
		</supported-bridge-type-refs>

		<label>Danfoss Link Living Zone</label>
		<description>Shared regulation for rooms in the controller's Living zone</description>

		<channels>
			<channel id="manual" typeId="manual">
				<description>Enable manual operation for the Living zone (ON), or resume its schedule (OFF)</description>
			</channel>
		</channels>
	</thing-type>

	<thing-type id="room">
		<supported-bridge-type-refs>
			<bridge-type-ref id="controller"/>
		</supported-bridge-type-refs>

		<label>Danfoss Link Room</label>
		<description>A room managed by the controller</description>

		<channels>
			<channel id="temperature" typeId="temperature"/>
			<channel id="setpoint" typeId="setpoint"/>
			<channel id="home-setpoint" typeId="home-setpoint"/>
			<channel id="away-setpoint" typeId="away-setpoint"/>
			<channel id="manual-setpoint" typeId="manual-setpoint"/>
			<channel id="manual" typeId="manual">
				<description>Enable manual temperature or resume the schedule. For Living-zone rooms, this changes the entire Living
					zone.</description>
			</channel>
			<channel id="regulation-state" typeId="regulation-state"/>
		</channels>

		<config-description>
			<parameter name="roomId" type="integer" min="0" required="true">
				<label>Room ID</label>
				<description>Numeric room identifier reported by the controller</description>
			</parameter>
		</config-description>
	</thing-type>

</thing:thing-descriptions>
